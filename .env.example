# mingtu 环境变量模板
#
# 用法：cp .env.example .env，把真实 key 填进 .env。
# .env 已在 .gitignore 里，不要把真实 key 写进这个模板，也不要提交 .env。
# run.sh 启动时会读取 .env 并 export，之后 Python 侧从 os.environ 取值。
#
# key 的查找顺序（agent/llm.py、agent/index.py 里的实现）：
#   1) 进程环境变量
#   2) ~/Desktop/dev/curio/.env
#   3) ~/Desktop/dev/Curio-Automation/.env
# 也就是说本机上就算这里留空也可能跑得起来 —— 那是本机开发的便利，
# 部署到别的机器上必须在这里配全，否则第一个用户提问就会失败。


# ---- ANTHROPIC_API_KEY ------------------------------------------------------
# 用途：claude-opus-5，负责风险分流、查询重排、生成回答，以及不合格回答的重写。
# 缺失时的行为：降级但不崩溃。确定性安全层（报警症状筛查、急症固定话术）、
#   BM25+向量检索、元数据配额全部照常工作，只是不产出自然语言回答，
#   接口会返回「未配置 ANTHROPIC_API_KEY」并说明本轮检索到多少条资料。
# 必需程度：生产必需。
ANTHROPIC_API_KEY=

# ---- OPENAI_API_KEY ---------------------------------------------------------
# 用途：text-embedding-3-large。两处都要用：
#   a) 构建索引时把 443 个知识块转成向量（python -m agent.index build）
#   b) 每一轮用户提问都要把问题本身转成向量，才能做向量召回
# 注意：b 是运行时依赖，不是只在构建时用。当前实现里 agent/index.py 的
#   openai_key() 找不到 key 会直接 SystemExit，检索链路没有降级路径，
#   所以生产环境必须配，不能留空。
# 计费提醒：几个 OpenAI key 共用同一个账户额度，跑批量 embedding 前先探一次。
# 必需程度：生产必需（缺失会导致提问直接失败，而不是降级）。
OPENAI_API_KEY=

# ---- PERPLEXITY_API_KEY -----------------------------------------------------
# 用途：sonar-pro 实时补充检索。两种情况触发：问题涉及时效信息
#   （最新法规、菌种名单更新、品牌与价格、新发表的研究），
#   或者本地检索最高分低于阈值、再答下去就是猜。
# 缺失时的行为：search_live() 返回空列表，只用本地分级语料作答；
#   资料不足时按设计弃答，不会拿不对题的内容凑答案。
# 已知问题：tools/research.py 的 key() 目前只读上面那几个 .env 文件，
#   不读进程环境变量 —— 所以在这里填了值，实时检索这一路还是拿不到。
#   要么修 key() 让它先看 os.environ，要么把 key 写进 ~/Desktop/dev/curio/.env。
# 必需程度：可选（关掉只是失去时效性，不影响安全层和本地作答）。
PERPLEXITY_API_KEY=


# ---- 网页服务监听地址 --------------------------------------------------------
# run.sh 会把这两个变量 export 给网页服务进程。
# 默认只监听本机回环地址：这是一个健康咨询服务，不要在没有反向代理和
# 访问控制的情况下直接暴露到公网。确实要对外时再改成 0.0.0.0。
MINGTU_HOST=127.0.0.1
MINGTU_PORT=8000
