# mingtu 环境变量模板
#
# 用法：cp .env.example .env，按需填值，然后用 ./run.sh 启动。
# .env 已在 .gitignore 里。不要把真实 key 写进这个模板，也不要提交 .env。
#
# 这个项目可以完全不联网跑：向量用本地 ollama，回答用本地模型或干脆不作答，
# 安全层和检索层本来就不依赖任何外部服务。下面每一项都标了必需程度。
#
# 为什么用 ./run.sh 启动，而不是直接 python web/server.py：
# 各模块的 key 查找规则不完全一致，只有 agent/llm.py 会读项目根目录的 .env。
# run.sh 会先把 .env 里的值 export 到进程环境，这样所有模块看到的是同一份配置。
# 绕过 run.sh 直接启动，容易出现「作答模型取到了 key、检索没取到」这种
# 一半能跑的状态。


# ============================================================================
# 一、向量（检索的一半，另一半 BM25 不需要任何配置）
# ============================================================================
# agent/embed.py 按这个顺序挑后端：
#   1) ollama（本地，bge-m3，1024 维）—— 只要服务活着且已 pull 模型就优先用
#   2) OpenAI（text-embedding-3-large，3072 维）—— 需要 key，要出网
# 两个后端是两个向量空间，索引按后端分文件存，不会混用。
# 换后端之后必须重建索引：python -m agent.index build

# ---- OLLAMA_HOST ------------------------------------------------------------
# 本地 ollama 服务地址。默认值就是下面这个，一般不用改。
# 准备本地后端：安装 ollama 后执行  ollama pull bge-m3
# 必需程度：可选（不填走默认值）。
OLLAMA_HOST=http://127.0.0.1:11434

# ---- MINGTU_EMBED_MODEL -----------------------------------------------------
# 本地 embedding 模型名。默认 bge-m3：中文检索效果好，1024 维。
# 换模型必须重建索引，维度不同的向量不能和旧索引混用。
# 必需程度：可选。
MINGTU_EMBED_MODEL=bge-m3

# ---- MINGTU_LOCAL_ONLY ------------------------------------------------------
# 置 1 表示禁止任何出网的向量调用：ollama 不可用时直接报错，绝不回落到 OpenAI。
# 用于数据不能出境的部署 —— 用户问的是自己的健康状况，把这些文本发到境外 API
# 在《个人信息保护法》下是数据出境问题。开着这一项，问题就不存在。
# 必需程度：可选（默认关闭）。
MINGTU_LOCAL_ONLY=

# ---- OPENAI_API_KEY ---------------------------------------------------------
# 用途：text-embedding-3-large，作为本地 ollama 不可用时的向量后端。
#   建索引和每一轮用户提问都要用到 —— 提问也要先向量化才能做向量召回，
#   所以它是运行时依赖，不是只在构建时用。
#   agent/llm.py 也会把 OpenAI 当作作答模型的第二档回落。
# 缺失时的行为：只要本地 ollama 活着就完全不需要它；两个都没有，检索起不来。
# 计费提醒：几个 OpenAI key 共用同一个账户额度，跑批量 embedding 前先探一次。
# 必需程度：本地 ollama 可用时不需要；否则必需。
OPENAI_API_KEY=


# ============================================================================
# 二、作答模型
# ============================================================================
# agent/llm.py 按 Anthropic → OpenAI → Perplexity 依次回落。
# 回落是为了让服务在没有 Anthropic 账号的机器上也能跑，不代表几个模型可以
# 互相替代 —— 这套提示词和引用纪律是照着 claude-opus-5 写的。
# 三个都没有时服务仍然启动：确定性安全层（报警症状筛查、急症固定话术）和
# 检索层照常工作，只是不生成自然语言回答。

# ---- ANTHROPIC_API_KEY ------------------------------------------------------
# 用途：claude-opus-5，负责风险分流、证据重排、生成回答，以及回答没通过
#   引用校验或合规校验时的重写。
# 必需程度：生产必需（要质量就配这一个）。
ANTHROPIC_API_KEY=


# ============================================================================
# 三、实时补充检索
# ============================================================================

# ---- PERPLEXITY_API_KEY -----------------------------------------------------
# 用途：sonar-pro。两种情况触发：问题涉及时效信息（最新法规、菌种名单更新、
#   品牌与价格、新发表的研究），或者本地检索最高分低于阈值、再答下去就是猜。
#   也是作答模型的最后一档回落。
# 缺失时的行为：search_live() 返回空列表，只用本地分级语料作答；资料不足时
#   按设计弃答，不会拿不对题的内容凑答案。
# 已知问题：tools/research.py 的 key() 只读 ~/Desktop/dev/{curio,
#   Curio-Automation,curio-international}/.env，既不读环境变量也不读本项目
#   .env。所以填在这里，实时检索这一路拿不到（作答回落那一路能拿到，
#   因为走的是 agent/llm.py 的取值函数）。要让实时检索生效：改 key() 让它
#   先看 os.environ，或者把 key 写进 ~/Desktop/dev/curio/.env。
# 必需程度：可选（关掉只是失去时效性，不影响安全层和本地作答）。
PERPLEXITY_API_KEY=


# ============================================================================
# 四、网页服务
# ============================================================================
# web/server.py 读 HOST / PORT 作为 --host / --port 的默认值。
# 默认只监听本机回环地址：这是一个健康咨询服务，不要在没有反向代理和访问
# 控制的情况下直接暴露到公网。局域网内演示再改成 0.0.0.0。
HOST=127.0.0.1
PORT=8000
